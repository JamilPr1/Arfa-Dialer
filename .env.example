MIGHTYCALL_API_BASE_URL=https://api.mightycall.com/v4
MIGHTYCALL_API_KEY=YOUR_API_KEY_HERE
MIGHTYCALL_API_SECRET_KEY=YOUR_USER_KEY_OR_EXTENSION_HERE

# WebPhone (browser) agent credentials (1 per simultaneous user/tab)
#
# IMPORTANT:
# - If your MightyCall account uses "Sign-in by key" then these MUST be "User Key" values (NOT extensions like 100/101).
# - If your account uses extension login, you can use extensions (100/101/...) here instead.
MIGHTYCALL_WEBPHONE_SECRET_KEY=USERKEY_OR_EXTENSION_USER1
MIGHTYCALL_WEBPHONE_SECRET_KEYS=USERKEY_OR_EXTENSION_USER2,USERKEY_OR_EXTENSION_USER3,USERKEY_OR_EXTENSION_USER4,USERKEY_OR_EXTENSION_USER5
APP_ACCESS_KEY=OPTIONAL_PASSWORD_FOR_WEBPHONE_CONFIG
PORT=5173

